{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "open_emby 插件 manifest (plugin.json)",
  "type": "object",
  "required": ["id", "name", "version", "type", "entry", "permissions"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "type": { "enum": ["workflow", "exporter", "tool", "agent-skill", "theme"] },
    "entry": { "type": "string", "description": "相对插件目录的入口文件" },
    "permissions": {
      "type": "array",
      "items": { "enum": ["fs", "net", "comfyui", "sidecar"] },
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "properties": {
        "menus": { "type": "array", "items": { "type": "object", "required": ["id", "label"],
          "properties": { "id": { "type": "string" }, "label": { "type": "string" } } } },
        "panels": { "type": "array", "items": { "type": "object", "required": ["id", "title"],
          "properties": { "id": { "type": "string" }, "title": { "type": "string" } } } }
      }
    }
  }
}
