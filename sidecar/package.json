{
  "name": "open-emby-sidecar",
  "version": "0.1.0",
  "description": "open_emby digitizing sidecar — pure TypeScript (no Python business logic)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "bundle": "esbuild src/main.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/sidecar.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.1",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
